#!/usr/bin/env bash

set -euo pipefail

if [[ $# -gt 1 ]]; then
  echo "Usage: $0 [ios-core-device-id]" >&2
  exit 2
fi

project_dir=$(cd "$(dirname "$0")/.." && pwd)
device=${1:-}
detected_target=
device_json=
development_team=${KLEAD_IOS_DEVELOPMENT_TEAM:-}
local_properties="$project_dir/local.properties"
if [[ -z $development_team && -f $local_properties ]]; then
  while IFS='=' read -r key value; do
    if [[ $key == "klead.iosDevelopmentTeam" ]]; then
      development_team=$value
      break
    fi
  done < "$local_properties"
fi
development_team=${development_team//[[:space:]]/}
if [[ ! $development_team =~ ^[A-Z0-9]{10}$ ]]; then
  echo "Set KLEAD_IOS_DEVELOPMENT_TEAM or klead.iosDevelopmentTeam in local.properties to a 10-character Apple development team ID." >&2
  exit 1
fi
if [[ -z $device ]]; then
  if ! command -v jq >/dev/null; then
    echo "jq is required to auto-detect an iPhone; pass a CoreDevice identifier explicitly." >&2
    exit 1
  fi
  device_json=$(mktemp "${TMPDIR:-/tmp}/klead-ios-devices.XXXXXX")
  trap 'rm -f "$device_json"' EXIT
  xcrun devicectl list devices --json-output "$device_json" --quiet
  device=$(jq -r '
    [.result.devices[]
      | select(.hardwareProperties.productType | startswith("iPhone"))
      | select(.connectionProperties.transportType != null)][0].identifier // empty
  ' "$device_json")
  detected_target=$(jq -r '
    [.result.devices[]
      | select(.identifier == $device)][0].hardwareProperties.productType // empty
  ' --arg device "$device" "$device_json" | tr '[:upper:],' '[:lower:]_')
fi
if [[ -z $device ]]; then
  echo "No connected physical iPhone found." >&2
  exit 1
fi
host_dir="$project_dir/benchmarks/ios-device-host"
derived_data="$project_dir/build/ios-device-benchmark"
project_file="$host_dir/KleadBenchmarkHost.xcodeproj"
app_path="$derived_data/Build/Products/Release-iphoneos/KleadBenchmarkHost.app"
result_dir="$project_dir/build/test-results/iosArm64PhysicalRegressionBenchmark"
result_file="$result_dir/output.txt"
sample_count=${KLEAD_BENCHMARK_SAMPLES:-5}
benchmark_target=${KLEAD_IOS_BENCHMARK_TARGET:-${detected_target:-ios-arm64-device}}
baseline_file="$project_dir/benchmarks/regression-corpus-baselines.properties"
default_maximum_median=$(awk -F= '$1 == "ios-device.core.maxMedianMillis" { print $2 }' "$baseline_file")
default_maximum_p95=$(awk -F= '$1 == "ios-device.core.maxP95ArticleMillis" { print $2 }' "$baseline_file")
default_maximum_worst=$(awk -F= '$1 == "ios-device.core.maxWorstArticleMillis" { print $2 }' "$baseline_file")
maximum_median=${KLEAD_REGRESSION_CORE_MAX_MEDIAN_MS:-$default_maximum_median}
maximum_p95=${KLEAD_REGRESSION_CORE_MAX_P95_ARTICLE_MS:-$default_maximum_p95}
maximum_worst=${KLEAD_REGRESSION_CORE_MAX_WORST_ARTICLE_MS:-$default_maximum_worst}

cd "$project_dir"
./gradlew -q --console=plain linkBenchmarkReleaseTestIosArm64

xcodegen generate --spec "$host_dir/project.yml" --project "$host_dir"
xcodebuild \
  -quiet \
  -project "$project_file" \
  -scheme KleadBenchmarkHost \
  -configuration Release \
  -destination "id=$device" \
  -derivedDataPath "$derived_data" \
  -allowProvisioningUpdates \
  DEVELOPMENT_TEAM="$development_team" \
  clean build

xcrun devicectl device install app --device "$device" "$app_path"
mkdir -p "$result_dir"
xcrun devicectl device process launch \
  --console \
  --terminate-existing \
  --timeout 900 \
  --environment-variables \
  "{\"KLEAD_RUN_REGRESSION_BENCHMARK\":\"true\",\"KLEAD_BENCHMARK_PLATFORM\":\"ios-device\",\"KLEAD_BENCHMARK_TARGET\":\"$benchmark_target\",\"KLEAD_BENCHMARK_SAMPLES\":\"$sample_count\",\"KLEAD_REGRESSION_CORE_MAX_MEDIAN_MS\":\"$maximum_median\",\"KLEAD_REGRESSION_CORE_MAX_P95_ARTICLE_MS\":\"$maximum_p95\",\"KLEAD_REGRESSION_CORE_MAX_WORST_ARTICLE_MS\":\"$maximum_worst\"}" \
  --device "$device" \
  com.prof18.klead.benchmark \
  --ktest_filter=com.prof18.klead.fixtures.RegressionCorpusBenchmarkTest.* \
  | tee "$result_file"

echo "Physical iOS benchmark output: $result_file"
